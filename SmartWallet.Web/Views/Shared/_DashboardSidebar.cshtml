@using System.Security.Claims
@{
    var userName = User?.Identity?.Name ?? "Usuário";
}

<aside class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse" id="dashboardSidebar">
    <div class="position-sticky pt-3">
        <div class="px-3 mb-4">
            <div class="fw-bold">Olá, @userName</div>
            <small class="text-muted">Bem-vindo ao SmartWallet</small>
        </div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link active" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Transactions" asp-action="Index">
                    <i class="bi bi-list-task me-2"></i> Transações
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-tags me-2"></i> Categorias
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Transactions" asp-action="Create">
                    <i class="bi bi-plus-circle me-2"></i> Nova Transação
                </a>
            </li>
            <li class="nav-item mt-3">
                <a class="nav-link" asp-controller="Account" asp-action="Logout" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                    <i class="bi bi-box-arrow-right me-2"></i> Sair
                </a>
            </li>
        </ul>
    </div>
</aside>
