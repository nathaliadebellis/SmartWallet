@{
    ViewData["Title"] = "SmartWallet";
}

<section id="cta" class="cta">

    <div class="container">

        <div class="cta-card">

            <span class="cta-badge">

                Comece agora

            </span>

            <h2 class="cta-title">

                Assuma o controle da sua vida financeira.

            </h2>

            <p class="cta-description">

