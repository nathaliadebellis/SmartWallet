@{
    ViewData["Title"] = "SmartWallet";
}

<!-- RECURSOS -->

<section id="features" class="features">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">
                Recursos
            </span>

            <h2 class="section-title">
                Tudo o que você precisa para organizar sua vida financeira
            </h2>

            <p class="section-description">
                O SmartWallet reúne as principais ferramentas para tornar o controle financeiro simples, seguro e intuitivo.
            </p>

        </div>

        <div class="row g-4">

            <!-- Transações -->

            <div class="col-lg-4 col-md-6">

                <article class="feature-card">

                    <div class="feature-icon-wrapper">

                        <div class="feature-icon">

                            <i class="bi bi-credit-card"></i>

                        </div>

                    </div>

                    <h3 class="feature-title">
                        Transações
                    </h3>

                    <p class="feature-description">
                        Registre receitas e despesas rapidamente e acompanhe todo o seu histórico financeiro.
                    </p>

                    <div class="feature-footer">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>Controle financeiro</span>

                    </div>

                </article>

            </div>

            <!-- Dashboard -->

            <div class="col-lg-4 col-md-6">

                <article class="feature-card">

                    <div class="feature-icon-wrapper">

                        <div class="feature-icon">

                            <i class="bi bi-bar-chart-line"></i>

                        </div>

                    </div>

                    <h3 class="feature-title">
                        Dashboard
                    </h3>

                    <p class="feature-description">
                        Visualize indicadores e acompanhe sua evolução financeira em tempo real.
                    </p>

                    <div class="feature-footer">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>Visualização em tempo real</span>

                    </div>

                </article>

            </div>

            <!-- Metas -->

            <div class="col-lg-4 col-md-6">

                <article class="feature-card">

                    <div class="feature-icon-wrapper">

                        <div class="feature-icon">

                            <i class="bi bi-bullseye"></i>

                        </div>

                    </div>

                    <h3 class="feature-title">
                        Metas Financeiras
                    </h3>

                    <p class="feature-description">
                        Defina objetivos e acompanhe seu progresso para conquistar seus planos.
                    </p>

                    <div class="feature-footer">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>Objetivos financeiros</span>

                    </div>

                </article>

            </div>

            <!-- Categorias -->

            <div class="col-lg-4 col-md-6">

                <article class="feature-card">

                    <div class="feature-icon-wrapper">

                        <div class="feature-icon">

                            <i class="bi bi-tags"></i>

                        </div>

                    </div>

                    <h3 class="feature-title">
                        Categorias
                    </h3>

                    <p class="feature-description">
                        Organize suas movimentações por categorias e entenda seus hábitos de consumo.
                    </p>

                    <div class="feature-footer">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>Organização inteligente</span>

                    </div>

                </article>

            </div>

            <!-- Relatórios -->

            <div class="col-lg-4 col-md-6">

                <article class="feature-card">

                    <div class="feature-icon-wrapper">

                        <div class="feature-icon">

                            <i class="bi bi-file-earmark-bar-graph"></i>

                        </div>

                    </div>

                    <h3 class="feature-title">
                        Relatórios
                    </h3>

                    <p class="feature-description">
                        Analise receitas, despesas e tendências através de relatórios claros e objetivos.
                    </p>

                    <div class="feature-footer">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>Análise de dados</span>

                    </div>

                </article>

            </div>

            <!-- Segurança -->

            <div class="col-lg-4 col-md-6">

                <article class="feature-card">

                    <div class="feature-icon-wrapper">

                        <div class="feature-icon">

                            <i class="bi bi-shield-lock"></i>

                        </div>

                    </div>

                    <h3 class="feature-title">
                        Segurança
                    </h3>

                    <p class="feature-description">
                        Seus dados protegidos com autenticação individual e acesso seguro às informações.
                    </p>

                    <div class="feature-footer">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>Acesso protegido</span>

                    </div>

                </article>

            </div>

        </div>

    </div>

</section>