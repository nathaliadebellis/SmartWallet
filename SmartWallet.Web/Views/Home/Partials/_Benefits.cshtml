@{
    ViewData["Title"] = "SmartWallet";
}

<section id="benefits" class="benefits">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">

                Benefícios

            </span>

            <h2 class="section-title">

                Mais do que um controle financeiro

            </h2>

            <p class="section-description">

                O SmartWallet foi projetado para oferecer uma experiência moderna,
                intuitiva e segura para quem deseja organizar suas finanças.

            </p>

        </div>

        <div class="row g-4">

            <!-- Segurança -->

            <div class="col-lg-6">

                <article class="benefit-card">

                    <div class="benefit-icon">

                        <i class="bi bi-shield-lock"></i>

                    </div>

                    <div>

                        <h3 class="benefit-title">

                            Segurança

                        </h3>

                        <p class="benefit-description">

                            Seus dados permanecem protegidos com autenticação
                            individual e uma arquitetura preparada para
                            múltiplos usuários.

                        </p>

                    </div>

                </article>

            </div>

            <!-- Simplicidade -->

            <div class="col-lg-6">

                <article class="benefit-card">

                    <div class="benefit-icon">

                        <i class="bi bi-lightning-charge"></i>

                    </div>

                    <div>

                        <h3 class="benefit-title">

                            Simplicidade

                        </h3>

                        <p class="benefit-description">

                            Interface limpa e intuitiva para facilitar o
                            gerenciamento financeiro no dia a dia.

                        </p>

                    </div>

                </article>

            </div>

            <!-- Controle -->

            <div class="col-lg-6">

                <article class="benefit-card">

                    <div class="benefit-icon">

                        <i class="bi bi-graph-up-arrow"></i>

                    </div>

                    <div>

                        <h3 class="benefit-title">

                            Controle

                        </h3>

                        <p class="benefit-description">

                            Acompanhe receitas, despesas, metas financeiras
                            e indicadores em um único lugar.

                        </p>

                    </div>

                </article>

            </div>

            <!-- Organização -->

            <div class="col-lg-6">

                <article class="benefit-card">

                    <div class="benefit-icon">

                        <i class="bi bi-folder2-open"></i>

                    </div>

                    <div>

                        <h3 class="benefit-title">

                            Organização

                        </h3>

                        <p class="benefit-description">

                            Categorize suas movimentações e tenha uma visão
                            clara dos seus hábitos financeiros.

                        </p>

                    </div>

                </article>

            </div>

        </div>

    </div>

</section>