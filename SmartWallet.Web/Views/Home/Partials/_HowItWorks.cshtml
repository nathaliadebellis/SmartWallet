@{
    ViewData["Title"] = "SmartWallet";
}

<!-- COMO FUNCIONA -->

<section id="how-it-works" class="how-it-works">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">
                Como funciona
            </span>

            <h2 class="section-title">
                Comece a organizar sua vida financeira em apenas três passos
            </h2>

            <p class="section-description">
                O SmartWallet foi pensado para tornar o gerenciamento financeiro simples,
                intuitivo e eficiente desde o primeiro acesso.
            </p>

        </div>

        <div class="row position-relative justify-content-center g-4">

            <!-- Linha de conexão -->
            <div class="process-line d-none d-lg-block"></div>

            <!-- PASSO 1 -->

            <div class="col-lg-4">

                <article class="step-card">

                    <div class="step-number">
                        1
                    </div>

                    <div class="step-icon">

                        <i class="bi bi-pencil-square"></i>

                    </div>

                    <h3 class="step-title">
                        Cadastre
                    </h3>

                    <p class="step-description">

                        Registre receitas e despesas rapidamente
                        de forma organizada.

                    </p>

                </article>

            </div>

            <!-- PASSO 2 -->

            <div class="col-lg-4">

                <article class="step-card">

                    <div class="step-number">
                        2
                    </div>

                    <div class="step-icon">

                        <i class="bi bi-tags"></i>

                    </div>

                    <h3 class="step-title">
                        Organize
                    </h3>

                    <p class="step-description">

                        Utilize categorias para visualizar
                        melhor seus hábitos financeiros.

                    </p>

                </article>

            </div>

            <!-- PASSO 3 -->

            <div class="col-lg-4">

                <article class="step-card">

                    <div class="step-number">
                        3
                    </div>

                    <div class="step-icon">

                        <i class="bi bi-graph-up-arrow"></i>

                    </div>

                    <h3 class="step-title">
                        Acompanhe
                    </h3>

                    <p class="step-description">

                        Analise indicadores e acompanhe sua
                        evolução financeira.

                    </p>

                </article>

            </div>

        </div>

    </div>

</section>