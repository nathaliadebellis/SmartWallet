@{
    ViewData["Title"] = "SmartWallet";
}

<!-- TECNOLOGIAS -->

<section id="technologies" class="technologies">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">
                Tecnologias
            </span>

            <h2 class="section-title">
                Construído com tecnologias modernas
            </h2>

            <p class="section-description">
                O SmartWallet foi desenvolvido utilizando ferramentas amplamente
                adotadas no mercado para garantir desempenho, escalabilidade e
                facilidade de manutenção.
            </p>

        </div>

        <div class="technology-grid">

            <div class="technology-item">
                <i class="bi bi-filetype-cs"></i>
                <span>C#</span>
            </div>

            <div class="technology-item">
                <i class="bi bi-window-stack"></i>
                <span>ASP.NET Core</span>
            </div>

            <div class="technology-item">
                <i class="bi bi-database"></i>
                <span>Entity Framework</span>
            </div>

            <div class="technology-item">
                <i class="bi bi-server"></i>
                <span>SQL Server</span>
            </div>

            <div class="technology-item">
                <i class="bi bi-bootstrap"></i>
                <span>Bootstrap 5</span>
            </div>

            <div class="technology-item">
                <i class="bi bi-shield-lock"></i>
                <span>Identity</span>
            </div>

        </div>

    </div>

</section>